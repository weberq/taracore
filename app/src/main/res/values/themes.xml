<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A bare shell: Compose paints everything, and the only job of the platform theme
      is to avoid a white flash before the first frame.
    -->
    <style name="Theme.TaraCore" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tara_indigo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup is disabled at the application level (android:allowBackup="false"), so
  nothing here takes effect. It is kept, and kept empty, so that anyone who turns
  backup back on starts from "nothing is backed up" rather than from a default that
  would sweep up the API token in files/taracore_settings.json.
-->
<full-backup-content>
    <exclude domain="root" path="." />
</full-backup-content>

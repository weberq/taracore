<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="external" path="models" />
        <exclude domain="database" path="taracore-models" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="external" path="models" />
    </device-transfer>
</data-extraction-rules>

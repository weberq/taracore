<?xml version="1.0" encoding="utf-8"?>
<!--
  As with backup_rules.xml: backup is off, and these rules exclude everything so that
  re-enabling it cannot silently start copying the API token or gigabytes of model
  weights to cloud backup or to another device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>

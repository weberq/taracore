<?xml version="1.0" encoding="utf-8"?>
<!--
  The Tara mark: a four-point star inside a processor.

  The chip silhouette says what the app is - a piece of system hardware other apps
  build on - and the star is the brand. Everything sits inside the 72dp safe zone of
  the 108dp canvas, so no launcher mask can clip a pin.

  Two pins per side rather than three: at the 48dp a launcher actually draws, three
  merge into a smear.

  Keep this in step with sample-client's copy.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      The eight pins, as one stroked path with round caps. A 7-wide stroke with round
      caps from 25.5 to 29.5 gives a bar spanning 22 to 33, which is the same shape a
      rounded rectangle would take and a fraction of the path data.
    -->
    <path
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M 44.5,25.5 L 44.5,29.5
                          M 63.5,25.5 L 63.5,29.5
                          M 44.5,78.5 L 44.5,82.5
                          M 63.5,78.5 L 63.5,82.5
                          M 25.5,44.5 L 29.5,44.5
                          M 25.5,63.5 L 29.5,63.5
                          M 78.5,44.5 L 82.5,44.5
                          M 78.5,63.5 L 82.5,63.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="18" android:startY="18"
                android:endX="90" android:endY="90">
                <item android:offset="0" android:color="#FFE9A8" />
                <item android:offset="0.55" android:color="#F5C542" />
                <item android:offset="1" android:color="#E39A12" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Chip body: a rounded square outline, 30 to 78, corner radius 12. -->
    <path
        android:strokeWidth="7"
        android:strokeLineJoin="round"
        android:pathData="M 42,30 h 24 a 12,12 0 0 1 12,12 v 24
                          a 12,12 0 0 1 -12,12 h -24 a 12,12 0 0 1 -12,-12 v -24
                          a 12,12 0 0 1 12,-12 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="18" android:startY="18"
                android:endX="90" android:endY="90">
                <item android:offset="0" android:color="#FFE9A8" />
                <item android:offset="0.55" android:color="#F5C542" />
                <item android:offset="1" android:color="#E39A12" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
      The star. Concave sides rather than straight ones: a straight-edged four-point
      star reads as a diamond at small sizes, where the pinch is what makes it a star.
    -->
    <path
        android:pathData="M 54,41 Q 56.8,51.2 67,54 Q 56.8,56.8 54,67
                          Q 51.2,56.8 41,54 Q 51.2,51.2 54,41 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18" android:startY="18"
                android:endX="90" android:endY="90">
                <item android:offset="0" android:color="#FFE9A8" />
                <item android:offset="0.55" android:color="#F5C542" />
                <item android:offset="1" android:color="#E39A12" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is off by default since Android 9, and the HTTP surface is plain HTTP on
  loopback. Allowing cleartext for 127.0.0.1 alone keeps the default protection for
  every other destination: nothing here weakens security for real network traffic.

  A TLS certificate for 127.0.0.1 would have to be either self-signed (so every
  client has to be told to trust it) or shipped with its private key (so it is not a
  secret). Loopback traffic never leaves the device, so the token is the control that
  matters, not transport encryption.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
